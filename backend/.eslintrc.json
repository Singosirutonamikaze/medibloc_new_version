{
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module"
  },
  "plugins": ["@typescript-eslint"],
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended"
  ],
  "rules": {
    "@typescript-eslint/no-explicit-any": "error",
    "@typescript-eslint/no-unused-vars": ["error", { "argsIgnorePattern": "^_" }],
    "no-restricted-syntax": [
      "error",
      {
        "selector": "TSUnknownKeyword",
        "message": "L'utilisation du type 'unknown' est interdite. Veuillez utiliser une interface typée explicite."
      }
    ]
  },
  "ignorePatterns": ["dist", "node_modules", "logs", "coverage", "*.config.ts", "*.config.js"]
}
